# StemLab AI — Dedicated AI Inference Worker Dockerfile
FROM python:3.12-slim

# Install system dependencies including FFmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install worker requirements
COPY apps/worker/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download Demucs htdemucs model weights into image cache to prevent cold start delays
RUN python -c "from demucs.pretrained import get_model; get_model('htdemucs')"

# Copy source code
COPY apps/api/app /app/app
COPY apps/worker /app/apps/worker
COPY packages /app/packages

# Create non-root worker user
RUN useradd -m -u 1000 workeruser && \
    mkdir -p /app/storage/inputs /app/storage/outputs /app/storage/exports && \
    chown -R workeruser:workeruser /app

USER workeruser

ENV PYTHONPATH=/app:/app/apps/worker:/app/app
ENV STORAGE_LOCAL_DIR=/app/storage

CMD ["python", "apps/worker/worker.py"]
