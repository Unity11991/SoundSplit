# StemLab AI Environment Configuration

# Project Metadata
PROJECT_NAME="StemLab AI"
VERSION="1.0.0"

# Database Configuration (PostgreSQL for production / SQLite for local development)
DATABASE_URL="sqlite:///./stemlab.db"
# DATABASE_URL="postgresql://postgres:stemlab_secret_password@localhost:5432/stemlab_db"

# Redis Queue & Event Bus
REDIS_URL="redis://localhost:6379/0"
REDIS_QUEUE_NAME="stemlab:separations"

# Storage Configuration ('local' or 's3')
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="./storage"

# Optional AWS S3 / MinIO Configuration
# S3_BUCKET="stemlab-audio"
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="us-east-1"

# Upload & Audio Processing Limits
MAX_UPLOAD_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=600

# AI Model Configuration
DEFAULT_MODEL="htdemucs"
DEFAULT_DEVICE="auto"  # 'auto', 'cuda', 'cpu'
DEMUCS_SEGMENT=8
DEMUCS_OVERLAP=0.25
DEMUCS_SHIFTS=1

# Security & Sessions
SECRET_KEY="replace-with-a-random-64-character-secret-in-production"
SESSION_COOKIE_NAME="stemlab_session"
SIGNED_URL_EXPIRATION_SECONDS=3600
RETENTION_HOURS=24

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000"
